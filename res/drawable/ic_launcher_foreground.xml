<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speedometer arc: 270° sweep, from bottom-left through the top
         to bottom-right. Stroke is thick so it survives small sizes. -->
    <path
        android:pathData="M 36.3,72.7 A 25,25 0 1 1 71.7,72.7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Needle pointing up-right at 45° -->
    <path
        android:pathData="M 54,55 L 67,42"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Hub: the pivot point of the needle -->
    <path
        android:pathData="M 54,55 m -5.5,0 a 5.5,5.5 0 1,0 11,0 a 5.5,5.5 0 1,0 -11,0"
        android:fillColor="#FFFFFF" />
</vector>